  },
  "dependencies": {
    "@julusian/midi": "3.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pocket-master/core": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
