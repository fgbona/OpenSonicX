{
  "name": "@pocket-master/web",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "esbuild lib/convert.worker.ts --bundle --format=esm --target=es2022 --outfile=public/convert-worker.js --log-level=warning",
