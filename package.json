{
  "name": "pocket-master-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "npm run dev -w @pocket-master/web",
    "build": "turbo run build --filter=!@pocket-master/desktop",
    "e2e": "npm run e2e -w @pocket-master/web",
    "e2e:live": "npm run e2e:live -w @pocket-master/web"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
